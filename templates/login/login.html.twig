{% extends 'layout.html.twig' %}

{% block title %}Sign In — Marketplace{% endblock %}

{% block content %}
    <div class="container mp-animate-fade">
        <div class="mp-form-card mp-animate-in">
            <h2><i class="fa-solid fa-right-to-bracket me-2" style="color: var(--mp-accent);"></i>Welcome Back</h2>
            <p class="mp-form-subtitle">Sign in to manage your adverts and saved items</p>

            {% if error %}
                <div class="alert alert-danger border-0 mb-4" style="background: rgba(239, 68, 68, 0.15); color: #f87171; font-size: 0.85rem; border-radius: var(--mp-radius-sm);">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>{{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form action="{{ path('app_login') }}" method="post" data-recaptcha-action="login" class="recaptcha-form">
                <div class="mp-form-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" name="_username" value="{{ last_username }}" class="form-control" placeholder="Enter your username" required autofocus>
                </div>

                <div class="mp-form-group">
                    <label for="password">Password</label>
                    <div class="mp-password-wrapper">
                        <input type="password" id="password" name="_password" class="form-control" placeholder="Enter your password" required autocomplete="current-password">
                        <button type="button" class="mp-password-toggle" aria-label="Show password" title="Show password" tabindex="-1">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                {% if is_granted('ROLE_MODERATOR') %}
                    <input type="hidden" name="_target_path" value="{{ path('admin')}}">
                {% else %}
                    <input type="hidden" name="_target_path" value="{{ path('home')}}">
                {% endif %}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="mp-btn mp-btn-primary w-100 justify-content-center mt-3">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
                </button>
            </form>

            <div class="text-center mt-4 pt-3 border-top" style="border-color: var(--mp-border-glass) !important;">
                <span style="color: var(--mp-text-muted); font-size: 0.85rem;">Don't have an account?</span>
                <a href="{{ path('app_register') }}" class="ms-1" style="font-weight: 500;">Register now</a>
            </div>
        </div>
    </div>
{% endblock %}
