{% extends 'base.html.twig' %}

{% block body %}
    {# ======== NAVBAR ======== #}
    <nav class="mp-navbar navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="{{ path('home') }}">
                <i class="fa-solid fa-store me-2"></i>Marketplace
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mpNavbar" aria-controls="mpNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars" style="color: var(--mp-text-secondary);"></i>
            </button>

            <div class="collapse navbar-collapse" id="mpNavbar">
                {# Search form #}
                <div class="mx-auto mp-navbar-search">
                    {{ form_start(search_form, {'attr': {'class': 'd-flex gap-2 align-items-center'}}) }}
                    {{ form_widget(search_form.title, {'attr': {'class': 'form-control', 'placeholder': 'Search adverts...'}}) }}
                    {{ form_widget(search_form.category, {'attr': {'class': 'form-select'}}) }}
                    <button type="submit" class="mp-btn mp-btn-primary mp-btn-sm">
                        <i class="fa-solid fa-search"></i>
                    </button>
                    {{ form_end(search_form) }}
                </div>

                {# Nav links #}
                <ul class="navbar-nav ms-auto align-items-center gap-1">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('home') }}"><i class="fa-solid fa-house"></i> Home</a>
                    </li>

                    {% if is_granted('ROLE_MODERATOR') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin') }}"><i class="fa-solid fa-gauge"></i> Dashboard</a>
                        </li>
                    {% endif %}

                    {% if is_granted('ROLE_USER') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('new_advert') }}"><i class="fa-solid fa-plus"></i> New Advert</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('user_advert') }}"><i class="fa-solid fa-folder-open"></i> My Adverts</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('user_favorites') }}"><i class="fa-solid fa-heart" style="color: var(--mp-danger);"></i> Saved</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('user_inbox') }}"><i class="fa-solid fa-comments"></i> Messages</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('show_profile') }}"><i class="fa-solid fa-user"></i> Profile</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a href="{{ path('show_profile') }}">
                                <img src="{{ asset('images/' ~ app.user.imageFileName) }}" alt="Avatar" class="mp-avatar">
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_logout') }}"><i class="fa-solid fa-right-from-bracket"></i></a>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="mp-btn mp-btn-outline mp-btn-sm" href="{{ path('app_login') }}"><i class="fa-solid fa-right-to-bracket"></i> Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="mp-btn mp-btn-primary mp-btn-sm" href="{{ path('app_register') }}"><i class="fa-solid fa-user-plus"></i> Register</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    {# ======== MAIN CONTENT ======== #}
    <main class="mp-main-content">
        {% block content %}{% endblock %}
    </main>

    {# ======== FOOTER ======== #}
    <footer class="mp-footer">
        <div class="container">
            <p class="mp-footer-text">© {{ 'now' | date('Y') }} Marketplace — Built with Symfony. All rights reserved.</p>
        </div>
    </footer>
{% endblock %}