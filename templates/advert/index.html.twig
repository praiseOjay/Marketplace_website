{% extends 'layout.html.twig' %}

{% block title %}Browse Adverts — Marketplace{% endblock %}

{% block content %}
    <div class="container mp-animate-fade">
        {# Section header #}
        <div class="mp-section-header">
            <h2>Browse Adverts</h2>
            <p>Discover great deals from our community</p>
        </div>

        {% if pagination is empty %}
            <div class="mp-empty-state">
                <i class="fa-solid fa-box-open"></i>
                <h3>No adverts yet</h3>
                <p>Be the first to post an advert on the marketplace!</p>
                {% if is_granted('ROLE_USER') %}
                    <a href="{{ path('new_advert') }}" class="mp-btn mp-btn-primary mt-3">
                        <i class="fa-solid fa-plus"></i> Create Advert
                    </a>
                {% endif %}
            </div>
        {% else %}
            <div class="row g-4 mp-stagger">
                {% for advert in pagination %}
                    <div class="col-12 col-sm-6 col-lg-4 mp-animate-in">
                        <div class="mp-card h-100">
                            {# Image #}
                            <div class="mp-card-img-wrapper">
                                <img src="{{ asset('images/' ~ advert.imageFileName) }}" alt="{{ advert.title }}" loading="lazy" decoding="async">
                                {# Favorite button #}
                                {% if is_granted('ROLE_USER') %}
                                    <a href="{{ path('favorite_advert', {'id': advert.id}) }}" class="mp-favorite-btn {% if advert.isFavoritedBy(app.user) %}active{% endif %}">
                                        <i class="fa-{% if advert.isFavoritedBy(app.user) %}solid{% else %}regular{% endif %} fa-heart"></i>
                                    </a>
                                {% endif %}
                                {# Price overlay #}
                                <div class="mp-card-img-overlay">
                                    <span class="mp-price">£{{ advert.price | number_format(0) }}</span>
                                </div>
                            </div>

                            {# Body #}
                            <div class="mp-card-body">
                                <h5 class="mp-card-title">
                                    <a href="{{ path('show_advert', {'slug': advert.slug}) }}">{{ advert.title }}</a>
                                </h5>
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    {% if advert.category %}
                                        <span class="mp-badge mp-badge-category">
                                            <i class="fa-solid fa-tag"></i> {{ advert.category.categoryName }}
                                        </span>
                                    {% endif %}
                                    {% set statusClass = {
                                        'published': 'published',
                                        'pending_review': 'pending',
                                        'draft': 'draft',
                                        'sold': 'sold',
                                        'rejected': 'rejected'
                                    } %}
                                    <span class="mp-badge mp-badge-{{ statusClass[advert.status.value] | default('draft') }}">
                                        {{ advert.status.label }}
                                    </span>
                                </div>
                            </div>

                            {# Footer #}
                            <div class="mp-card-footer">
                                <div class="mp-card-meta">
                                    <i class="fa-solid fa-user-circle"></i>
                                    {{ advert.getUser().getUsername() }}
                                </div>
                                <div class="mp-card-meta">
                                    <i class="fa-regular fa-clock"></i>
                                    {{ advert.timestamp | date('d M Y') }}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {# Pagination #}
            <nav class="mt-4 d-flex justify-content-center" aria-label="Advert pagination">
                {{ knp_pagination_render(pagination, 'pagination/twitter_bootstrap_v4_pagination.html.twig') }}
            </nav>
        {% endif %}
    </div>
{% endblock %}
