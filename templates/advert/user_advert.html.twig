{% extends 'layout.html.twig' %}

{% block title %}My Adverts — Marketplace{% endblock %}

{% block content %}
    <div class="container mp-animate-fade">
        <div class="mp-section-header d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h2><i class="fa-solid fa-folder-open me-2" style="color: var(--mp-accent);"></i>My Adverts</h2>
                <p>Manage your listings</p>
            </div>
            <a href="{{ path('new_advert') }}" class="mp-btn mp-btn-primary">
                <i class="fa-solid fa-plus"></i> New Advert
            </a>
        </div>

        {% if pagination is empty %}
            <div class="mp-empty-state">
                <i class="fa-solid fa-folder-open"></i>
                <h3>No adverts yet</h3>
                <p>Create your first advert to start selling.</p>
                <a href="{{ path('new_advert') }}" class="mp-btn mp-btn-primary mt-3">
                    <i class="fa-solid fa-plus"></i> Create Advert
                </a>
            </div>
        {% else %}
            <div class="mp-table-wrapper mp-animate-in">
                <table class="mp-table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Price</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for advert in pagination %}
                            <tr>
                                <td>
                                    <img src="{{ asset('images/' ~ advert.imageFileName) }}" alt="{{ advert.title }}" class="mp-table-thumb" loading="lazy" decoding="async">
                                </td>
                                <td>
                                    <a href="{{ path('show_advert', {'slug': advert.slug}) }}" style="color: var(--mp-text-primary); font-weight: 500;">
                                        {{ advert.title }}
                                    </a>
                                </td>
                                <td>
                                    {% set statusClass = {
                                        'published': 'published',
                                        'pending_review': 'pending',
                                        'draft': 'draft',
                                        'sold': 'sold',
                                        'rejected': 'rejected'
                                    } %}
                                    <span class="mp-badge mp-badge-{{ statusClass[advert.status.value] | default('draft') }}">
                                        {{ advert.status.label }}
                                    </span>
                                </td>
                                <td><span class="mp-price mp-price-sm">£{{ advert.price | number_format(0) }}</span></td>
                                <td style="color: var(--mp-text-muted); font-size: 0.85rem;">{{ advert.timestamp | date('d M Y') }}</td>
                                <td>
                                    <div class="mp-table-actions">
                                        <a href="{{ path('edit_advert', {'id': advert.id}) }}" class="mp-btn mp-btn-outline mp-btn-sm" title="Edit">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <a href="{{ path('delete_advert', {'id': advert.id}) }}" class="mp-btn mp-btn-danger mp-btn-sm" title="Delete" onclick="return confirm('Are you sure you want to delete this advert?');">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <nav class="mt-4 d-flex justify-content-center" aria-label="Advert pagination">
                {{ knp_pagination_render(pagination, 'pagination/twitter_bootstrap_v4_pagination.html.twig') }}
            </nav>
        {% endif %}
    </div>
{% endblock %}
