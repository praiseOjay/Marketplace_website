{% extends 'layout.html.twig' %}

{% block title %}My Adverts — Marketplace{% endblock %}

{% block content %}
    <div class="container mp-animate-fade">
        {# Header Section #}
        <div class="mp-section-header d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div>
                <h2><i class="fa-solid fa-folder-open me-2" style="color: var(--mp-accent);"></i>My Adverts</h2>
                <p class="mb-0">Manage, edit, or track your active marketplace listings</p>
            </div>
            <a href="{{ path('new_advert') }}" class="mp-btn mp-btn-primary shadow-sm">
                <i class="fa-solid fa-plus me-1"></i> Post New Advert
            </a>
        </div>

        {# Seller Stats Bar #}
        {% set totalCount = pagination.getTotalItemCount() %}
        {% set totalValue = 0 %}
        {% for item in pagination %}
            {% set totalValue = totalValue + item.price %}
        {% endfor %}

        <div class="row g-3 mb-4 mp-animate-in">
            <div class="col-12 col-md-6">
                <div class="p-3 rounded-4" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--mp-border-glass); backdrop-filter: blur(12px);">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted" style="font-size: 0.8rem; font-weight: 500;">Total Listings</span>
                            <h3 class="mb-0 mt-1" style="font-weight: 700; color: var(--mp-text-primary);">{{ totalCount }}</h3>
                        </div>
                        <div class="rounded-3 p-3 d-flex align-items-center justify-content-center" style="background: rgba(99, 102, 241, 0.15); color: var(--mp-accent); width: 48px; height: 48px;">
                            <i class="fa-solid fa-layer-group" style="font-size: 1.25rem;"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="p-3 rounded-4" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--mp-border-glass); backdrop-filter: blur(12px);">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted" style="font-size: 0.8rem; font-weight: 500;">Page Portfolio Value</span>
                            <h3 class="mb-0 mt-1" style="font-weight: 700; color: #10b981;">£{{ totalValue | number_format(0) }}</h3>
                        </div>
                        <div class="rounded-3 p-3 d-flex align-items-center justify-content-center" style="background: rgba(16, 185, 129, 0.15); color: #10b981; width: 48px; height: 48px;">
                            <i class="fa-solid fa-sterling-sign" style="font-size: 1.25rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Main Content #}
        {% if pagination is empty %}
            <div class="mp-empty-state mp-animate-in">
                <i class="fa-solid fa-folder-open mb-3" style="font-size: 3rem; color: var(--mp-text-muted);"></i>
                <h3>No adverts listed yet</h3>
                <p>Post your first item to start reaching thousands of active buyers.</p>
                <a href="{{ path('new_advert') }}" class="mp-btn mp-btn-primary mt-3">
                    <i class="fa-solid fa-plus me-1"></i> Post Advert Now
                </a>
            </div>
        {% else %}
            <div class="mp-table-wrapper mp-animate-in shadow-lg">
                <table class="mp-table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Item</th>
                            <th>Title & Category</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Date Posted</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for advert in pagination %}
                            <tr>
                                <td>
                                    <a href="{{ path('show_advert', {'slug': advert.slug}) }}">
                                        <img src="{{ asset(advert.imageFileName ? 'images/' ~ advert.imageFileName : 'images/default_image.png') }}" alt="{{ advert.title }}" class="mp-table-thumb shadow-sm" style="width: 60px; height: 48px; min-width: 60px; max-height: 48px; object-fit: cover; border-radius: 8px;" loading="lazy" decoding="async">
                                    </a>
                                </td>
                                <td>
                                    <div>
                                        <a href="{{ path('show_advert', {'slug': advert.slug}) }}" class="d-block text-decoration-none fw-semibold mb-1" style="color: var(--mp-text-primary); font-size: 0.95rem;">
                                            {{ advert.title }}
                                        </a>
                                        {% if advert.category %}
                                            <a href="{{ path('live_search', {'title': '', 'category': advert.category.id}) }}" class="mp-badge mp-badge-category text-decoration-none" style="font-size: 0.75rem;">
                                                <i class="fa-solid fa-tag me-1"></i>{{ advert.category.categoryName }}
                                            </a>
                                        {% endif %}
                                        {% if advert.location %}
                                            <span class="ms-1 text-muted" style="font-size: 0.75rem;">
                                                <i class="fa-solid fa-location-dot me-1 text-danger"></i>{{ advert.location }}
                                            </span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td>
                                    <span class="mp-price mp-price-sm">£{{ advert.price | number_format(0) }}</span>
                                </td>
                                <td>
                                    {% set statusClass = {
                                        'published': 'published',
                                        'pending_review': 'pending',
                                        'draft': 'draft',
                                        'sold': 'sold',
                                        'rejected': 'rejected'
                                    } %}
                                    <span class="mp-badge mp-badge-{{ statusClass[advert.status.value] | default('draft') }}">
                                        {{ advert.status.label }}
                                    </span>
                                </td>
                                <td>
                                    <span style="color: var(--mp-text-muted); font-size: 0.85rem;">
                                        <i class="fa-regular fa-calendar me-1"></i>{{ advert.timestamp | date('d M Y') }}
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center justify-content-end gap-2 pe-2">
                                        <a href="{{ path('show_advert', {'slug': advert.slug}) }}" class="mp-btn mp-btn-outline mp-btn-sm" title="View Listing">
                                            <i class="fa-solid fa-eye"></i> View
                                        </a>
                                        <a href="{{ path('edit_advert', {'id': advert.id}) }}" class="mp-btn mp-btn-outline mp-btn-sm" title="Edit Listing">
                                            <i class="fa-solid fa-pen-to-square"></i> Edit
                                        </a>
                                        <a href="{{ path('delete_advert', {'id': advert.id}) }}" class="mp-btn mp-btn-danger mp-btn-sm" title="Delete Listing" onclick="return confirm('Are you sure you want to delete this advert?');">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <nav class="mt-4 d-flex justify-content-center" aria-label="Advert pagination">
                {{ knp_pagination_render(pagination, 'pagination/twitter_bootstrap_v4_pagination.html.twig') }}
            </nav>
        {% endif %}
    </div>
{% endblock %}
