{% extends 'layout.html.twig' %}

{% block title %}{{ advert.title }} — Marketplace{% endblock %}

{% block content %}
    <div class="container mp-animate-fade py-3">
        {# Breadcrumb #}
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0" style="font-size: 0.875rem;">
                <li class="breadcrumb-item"><a href="{{ path('home') }}" class="text-decoration-none text-muted"><i class="fa-solid fa-house me-1"></i>Home</a></li>
                {% if advert.category %}
                    <li class="breadcrumb-item"><a href="{{ path('live_search', {'title': '', 'category': advert.category.id}) }}" class="text-decoration-none text-muted">{{ advert.category.categoryName }}</a></li>
                {% endif %}
                <li class="breadcrumb-item active text-light" aria-current="page">{{ advert.title | slice(0, 30) }}...</li>
            </ol>
        </nav>

        <div class="row g-4">
            {# Left: Image Showcase & Description #}
            <div class="col-lg-7">
                <div class="mp-detail-hero shadow-lg">
                    <img src="{{ asset(advert.imageFileName ? 'images/' ~ advert.imageFileName : 'images/default_image.png') }}" alt="{{ advert.title }}" decoding="async">
                    
                    <div class="mp-detail-hero-overlay">
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            {% if advert.category %}
                                <span class="mp-badge mp-badge-category">
                                    <i class="fa-solid fa-tag"></i> {{ advert.category.categoryName }}
                                </span>
                            {% endif %}
                            {% set statusClass = {
                                'published': 'published',
                                'pending_review': 'pending',
                                'draft': 'draft',
                                'sold': 'sold',
                                'rejected': 'rejected'
                            } %}
                            <span class="mp-badge mp-badge-{{ statusClass[advert.status.value] | default('draft') }}">
                                {{ advert.status.label }}
                            </span>
                        </div>
                    </div>

                    {# Favorite button #}
                    {% if is_granted('ROLE_USER') %}
                        <a href="{{ path('favorite_advert', {'id': advert.id}) }}" class="mp-favorite-btn {% if advert.isFavoritedBy(app.user) %}active{% endif %}" title="Save item">
                            <i class="fa-{% if advert.isFavoritedBy(app.user) %}solid{% else %}regular{% endif %} fa-heart"></i>
                        </a>
                    {% endif %}
                </div>

                {# Description Card #}
                <div class="mp-form-card mp-animate-in mt-4" style="max-width: 100%;">
                    <h4 class="mb-3" style="font-weight: 700; color: var(--mp-text-primary);">
                        <i class="fa-solid fa-align-left me-2 text-primary"></i>Item Description
                    </h4>
                    <p style="color: var(--mp-text-secondary); line-height: 1.8; font-size: 1rem; white-space: pre-line;">{{ advert.description }}</p>
                </div>
            </div>

            {# Right: Info Panel & Seller Sidebar #}
            <div class="col-lg-5">
                <div class="mp-detail-info mp-animate-in shadow-lg">
                    <h2 style="font-size: 1.65rem; font-weight: 800; color: #fff; margin-bottom: 0.75rem;">{{ advert.title }}</h2>
                    
                    <div class="d-flex align-items-baseline gap-2 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                        <span class="mp-price" style="font-size: 2.25rem;">£{{ advert.price | number_format(0) }}</span>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-2 py-1">Negotiable</span>
                    </div>

                    <div class="mp-detail-info-row">
                        <i class="fa-solid fa-location-dot text-danger"></i>
                        <div>
                            <span class="label">Location</span>
                            <span class="value">{{ advert.location | default('Not specified') }}</span>
                        </div>
                    </div>

                    <div class="mp-detail-info-row">
                        <i class="fa-regular fa-calendar text-info"></i>
                        <div>
                            <span class="label">Date Listed</span>
                            <span class="value">{{ advert.timestamp | date('d M Y, H:i') }}</span>
                        </div>
                    </div>

                    {# Seller Card #}
                    <div class="p-3 my-4 rounded-3 d-flex align-items-center justify-content-between" style="background: rgba(255, 255, 255, 0.04); border: 1px solid var(--mp-border-glass);">
                        <div class="d-flex align-items-center gap-3">
                            <img src="{{ asset(advert.getUser().imageFileName ? 'images/' ~ advert.getUser().imageFileName : 'images/default_avatar.png') }}" alt="{{ advert.getUser().getUsername() }}" class="rounded-circle" style="width: 48px; height: 48px; object-fit: cover; border: 2px solid var(--mp-accent);">
                            <div>
                                <div class="fw-bold" style="color: var(--mp-text-primary); font-size: 1rem;">{{ advert.getUser().getUsername() }}</div>
                                <div class="text-muted small"><i class="fa-solid fa-shield-check text-success me-1"></i> Verified Seller</div>
                            </div>
                        </div>
                    </div>

                    {# Action buttons #}
                    <div class="d-grid gap-2">
                        {% if is_granted('ROLE_USER') %}
                            {% if app.user == advert.getUser() %}
                                <a href="{{ path('edit_advert', {'id': advert.id}) }}" class="mp-btn mp-btn-primary w-100 justify-content-center py-2.5">
                                    <i class="fa-solid fa-pen me-1"></i> Edit My Advert
                                </a>
                            {% else %}
                                <a href="{{ path('send_message', {'advertId': advert.id}) }}" class="mp-btn mp-btn-primary w-100 justify-content-center py-2.5">
                                    <i class="fa-solid fa-paper-plane me-2"></i> Send Inquiry to Seller
                                </a>
                            {% endif %}
                        {% else %}
                            <a href="{{ path('app_login') }}" class="mp-btn mp-btn-primary w-100 justify-content-center py-2.5">
                                <i class="fa-solid fa-right-to-bracket me-2"></i> Log In to Contact Seller
                            </a>
                        {% endif %}

                        <a href="{{ path('home') }}" class="mp-btn mp-btn-outline w-100 justify-content-center mt-1">
                            <i class="fa-solid fa-arrow-left me-1"></i> Back to Marketplace
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
