{% extends 'layout.html.twig' %}

{% block title %}Saved Adverts — Marketplace{% endblock %}

{% block content %}
    <div class="container mp-animate-fade">
        <div class="mp-section-header d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h2><i class="fa-solid fa-heart me-2" style="color: var(--mp-danger);"></i>Saved Adverts</h2>
                <p>Items you have bookmarked for later</p>
            </div>
            <a href="{{ path('home') }}" class="mp-btn mp-btn-outline">
                <i class="fa-solid fa-arrow-left"></i> Browse All Adverts
            </a>
        </div>

        {% if pagination is empty %}
            <div class="mp-empty-state">
                <i class="fa-regular fa-heart"></i>
                <h3>No saved adverts yet</h3>
                <p>Click the heart icon on any advert card to save it to your bookmarks.</p>
                <a href="{{ path('home') }}" class="mp-btn mp-btn-primary mt-3">
                    <i class="fa-solid fa-store"></i> Explore Marketplace
                </a>
            </div>
        {% else %}
            <div class="row g-4 mp-stagger">
                {% for advert in pagination %}
                    <div class="col-12 col-sm-6 col-lg-4 mp-animate-in">
                        <div class="mp-card h-100">
                            <div class="mp-card-img-wrapper">
                                <img src="{{ asset(advert.imageFileName ? 'images/' ~ advert.imageFileName : 'images/default_image.png') }}" alt="{{ advert.title }}" loading="lazy" decoding="async">
                                <a href="{{ path('favorite_advert', {'id': advert.id}) }}" class="mp-favorite-btn active" title="Remove from saved">
                                    <i class="fa-solid fa-heart"></i>
                                </a>
                                <div class="mp-card-img-overlay">
                                    <span class="mp-price">£{{ advert.price | number_format(0) }}</span>
                                </div>
                            </div>

                            <div class="mp-card-body">
                                <h5 class="mp-card-title">
                                    <a href="{{ path('show_advert', {'slug': advert.slug}) }}">{{ advert.title }}</a>
                                </h5>
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    {% if advert.category %}
                                        <span class="mp-badge mp-badge-category">
                                            <i class="fa-solid fa-tag"></i> {{ advert.category.categoryName }}
                                        </span>
                                    {% endif %}
                                    {% set statusClass = {
                                        'published': 'published',
                                        'pending_review': 'pending',
                                        'draft': 'draft',
                                        'sold': 'sold',
                                        'rejected': 'rejected'
                                    } %}
                                    <span class="mp-badge mp-badge-{{ statusClass[advert.status.value] | default('draft') }}">
                                        {{ advert.status.label }}
                                    </span>
                                </div>
                            </div>

                            <div class="mp-card-footer">
                                <div class="mp-card-meta">
                                    <i class="fa-solid fa-user-circle"></i>
                                    {{ advert.getUser().getUsername() }}
                                </div>
                                <div class="mp-card-meta">
                                    <i class="fa-regular fa-clock"></i>
                                    {{ advert.timestamp | date('d M Y') }}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <nav class="mt-4 d-flex justify-content-center" aria-label="Saved adverts pagination">
                {{ knp_pagination_render(pagination, 'pagination/twitter_bootstrap_v4_pagination.html.twig') }}
            </nav>
        {% endif %}
    </div>
{% endblock %}
