{% extends 'layout.html.twig' %}

{% block title %}Edit Profile — Marketplace{% endblock %}

{% block content %}
    <div class="container mp-animate-fade">
        <div class="mp-form-card mp-animate-in">
            <h2><i class="fa-solid fa-user-pen me-2" style="color: var(--mp-accent);"></i>Edit Profile</h2>
            <p class="mp-form-subtitle">Update your personal account details and password</p>

            {{ form_start(form) }}
                <div class="mp-hp-wrapper" aria-hidden="true">
                    <label for="website_url">Leave this field blank</label>
                    <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off" value="">
                </div>

                <div class="mp-form-group">
                    {{ form_label(form.username, 'Username', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.username, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.username) }}
                </div>

                <div class="mp-form-group">
                    {{ form_label(form.email, 'Email Address', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'type': 'email'}}) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="p-3 my-3 rounded" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--mp-border-glass);">
                    <h6 class="mb-3" style="color: var(--mp-text-primary); font-size: 0.9rem;">
                        <i class="fa-solid fa-lock me-2" style="color: var(--mp-accent);"></i>Change Password
                    </h6>

                    <div class="mp-form-group">
                        {{ form_label(form.plainPassword.first, 'New Password', {'label_attr': {'class': 'form-label'}}) }}
                        <div class="mp-password-wrapper">
                            {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder': 'Leave blank to keep current'}}) }}
                            <button type="button" class="mp-password-toggle" aria-label="Show password" title="Show password" tabindex="-1">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        {{ form_errors(form.plainPassword.first) }}
                    </div>

                    <div class="mp-form-group mb-0">
                        {{ form_label(form.plainPassword.second, 'Confirm New Password', {'label_attr': {'class': 'form-label'}}) }}
                        <div class="mp-password-wrapper">
                            {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': 'Confirm new password'}}) }}
                            <button type="button" class="mp-password-toggle" aria-label="Show password" title="Show password" tabindex="-1">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        {{ form_errors(form.plainPassword.second) }}
                    </div>
                </div>

                <div class="mp-form-group">
                    {{ form_label(form.imageFile, 'Profile Picture', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.imageFile) }}
                </div>

                <div class="mt-4 d-grid gap-2">
                    {{ form_widget(form.save, {'attr': {'class': 'mp-btn mp-btn-primary w-100 justify-content-center'}, 'label': 'Save Profile'}) }}
                    <a href="{{ path('show_profile') }}" class="mp-btn mp-btn-outline w-100 justify-content-center mt-1">Cancel</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}